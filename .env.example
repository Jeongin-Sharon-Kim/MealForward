# Guardrail AX가 실제 LLM 분류를 사용하려면 둘 중 하나를 설정하세요.
# 둘 다 설정 시 OPENAI_API_KEY가 우선 사용됩니다.
# 둘 다 비어 있으면 server/guardrail.js의 룰 기반 폴백 분류기가 동작합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 관리자 회원가입 시 입력해야 하는 인증 키
ADMIN_SIGNUP_KEY=

PORT=3000

# PostgreSQL 연결 정보
DATABASE_URL=postgresql://localhost:5432/mealforward
